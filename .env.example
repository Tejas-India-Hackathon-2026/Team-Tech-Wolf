# ==========================================
# AGRO-SMART Environment Configuration Template
# ==========================================

# Backend Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
PORT=5000

# Supabase Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Crop Disease Detection Model Configuration (Optional API key - Local pathology engine enabled by default)
DISEASE_AI_API_KEY=your-disease-ai-key-here
DISEASE_AI_MODEL=resnet50-plant-pathology-v2

# Weather API Configuration (e.g. OpenWeatherMap, WeatherAPI, or Open-Meteo)
WEATHER_API_KEY=your-weather-api-key-here

# AgMarket / Data.gov.in Market Intelligence API (Optional - Fallback data included)
DATA_GOV_API_KEY=your-datagov-api-key-here

# Frontend API URL
VITE_API_BASE_URL=http://localhost:5000/api
