# ==========================================
# AGRO-SMART Full-Stack Environment Variables Template
# ==========================================

# 1. Flask Backend Server
FLASK_APP=backend/app.py
FLASK_ENV=development
PORT=5000
DEBUG=True

# 2. Supabase PostgreSQL Database (Optional for local development / prototype demo)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. Weather Intelligence API (Open-Meteo works by default with zero key required)
WEATHER_API_KEY=your-optional-weather-api-key

# 4. AI Crop Disease Detection Service (Gemini Multimodal Vision API)
GEMINI_API_KEY=your-gemini-api-key-here
DISEASE_API_KEY=your-optional-disease-ai-key
DISEASE_AI_MODEL=gemini-2.5-flash

# 5. AgMarket / APMC Market Data API (Optional - structured demo data active)
DATA_GOV_API_KEY=your-optional-datagov-api-key

# 6. Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000/api